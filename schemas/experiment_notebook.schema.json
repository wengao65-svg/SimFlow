{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimFlow Experiment Notebook Entry",
  "description": "Structured metadata embedded in one canonical append-only Experiment Markdown notebook.",
  "type": "object",
  "required": ["schema_version", "entry_id", "experiment_id", "entry_type", "summary", "created_at"],
  "properties": {
    "schema_version": { "const": "simflow.experiment_entry.v1" },
    "entry_id": { "type": "string", "pattern": "^ent_[0-9a-f]{12}$" },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9a-f]{12}$" },
    "entry_type": {
      "type": "string",
      "enum": ["experiment", "attempt", "observation", "decision"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "attempt_id": { "type": "string" },
    "parent_entry_ids": { "type": "array", "items": { "type": "string" } },
    "runtime_record_ids": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "details": { "type": "object" },
    "next_action": {},
    "idempotency_key": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
