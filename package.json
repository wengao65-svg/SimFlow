{
  "name": "simflow",
  "version": "1.5.0",
  "description": "Portable computational simulation Skills for AI agents",
  "private": true,
  "scripts": {
    "build:marketplace": "node scripts/build_marketplace_wrapper.js",
    "build:codex-marketplace": "node scripts/build_marketplace_wrapper.js dist/codex-marketplace --marketplace-name=simflow-marketplace",
    "build:claude-marketplace": "node scripts/build_claude_marketplace_wrapper.js dist/claude-marketplace --marketplace-name=simflow-claude-marketplace",
    "build:opencode-plugin": "node scripts/build_opencode_plugin.js dist/opencode-plugin",
    "install:codex": "node scripts/install_codex.js",
    "publish:codex-marketplace": "node scripts/publish_codex_marketplace.js",
    "publish:claude-marketplace": "node scripts/publish_claude_marketplace.js",
    "publish:opencode-plugin": "node scripts/publish_opencode_plugin.js",
    "validate": "npm run validate:all",
    "validate:plugin": "node scripts/validate_plugin.js",
    "validate:claude-plugin": "node scripts/validate_claude_plugin.js",
    "validate:opencode-plugin": "node scripts/validate_opencode_plugin.js",
    "validate:skills": "node scripts/validate_skills.js",
    "audit:skill-pack": "python scripts/audit_skill_pack.py",
    "validate:all": "npm run validate:plugin && npm run validate:claude-plugin && npm run validate:opencode-plugin && npm run validate:skills",
    "validate:release": "node scripts/validate_release.js",
    "release:notes": "node scripts/generate_release_notes.js",
    "scaffold:skill": "node scripts/scaffold_skill.js",
    "test:all": "python -m pytest tests/ -v",
    "test": "npm run test:all"
  },
  "devDependencies": {
    "ajv": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
