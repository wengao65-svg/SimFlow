{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimFlowExperimentMemory",
  "description": "Forward-only experiment, iteration, and activity memory stored under .simflow/memory/.",
  "type": "object",
  "definitions": {
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "description"],
      "properties": {
        "criterion_id": {"type": "string"},
        "description": {"type": "string"},
        "metric": {"type": "string"},
        "operator": {"type": "string"},
        "threshold": {},
        "unit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "experiment": {
      "type": "object",
      "required": ["experiment_id", "title", "objective", "stage", "root_path", "status", "history_scope", "created_at", "updated_at"],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^exp_[a-z0-9]{8}$"},
        "title": {"type": "string"},
        "objective": {"type": "string"},
        "stage": {"type": "string"},
        "recipe": {"type": ["string", "null"]},
        "root_path": {"type": "string"},
        "status": {"enum": ["active", "paused", "completed", "failed", "abandoned"]},
        "acceptance_criteria": {"type": "array", "items": {"$ref": "#/definitions/criterion"}},
        "current_iteration_id": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"]},
        "history_scope": {"const": "from_experiment_creation_only"},
        "legacy_inputs": {"type": "array"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "iteration": {
      "type": "object",
      "required": ["iteration_id", "experiment_id", "sequence", "objective", "status", "acceptance_criteria", "created_at", "updated_at"],
      "properties": {
        "iteration_id": {"type": "string", "pattern": "^iter_[a-z0-9]{8}$"},
        "experiment_id": {"type": "string", "pattern": "^exp_[a-z0-9]{8}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "parent_iteration_id": {"type": ["string", "null"]},
        "objective": {"type": "string"},
        "status": {"enum": ["planned", "running", "evaluating", "accepted", "rejected", "failed", "paused", "superseded"]},
        "acceptance_criteria": {"type": "array", "items": {"$ref": "#/definitions/criterion"}},
        "criterion_results": {"type": "array", "items": {"type": "object"}},
        "recovery": {"type": ["object", "null"]},
        "next_action": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "activityEvent": {
      "type": "object",
      "required": ["event_id", "event_type", "activity_id", "session_context_id", "experiment_id", "status"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt_[a-z0-9]{8}$"},
        "event_type": {"enum": ["activity_started", "activity_finished"]},
        "activity_id": {"type": "string", "pattern": "^act_[a-z0-9]{8}$"},
        "session_context_id": {"type": "string", "pattern": "^ctx_[a-z0-9]{8}$"},
        "experiment_id": {"type": "string", "pattern": "^exp_[a-z0-9]{8}$"},
        "iteration_id": {"type": ["string", "null"]},
        "status": {"enum": ["running", "completed", "partial", "failed", "paused", "cancelled"]},
        "command_redacted": {"type": ["string", "null"]},
        "command_sha256": {"type": ["string", "null"]},
        "restart_from": {"type": ["object", "null"]},
        "next_action": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/experiment"},
    {"$ref": "#/definitions/iteration"},
    {"$ref": "#/definitions/activityEvent"}
  ]
}
