{
  "schema_version": "simflow.router_contract.v2",
  "purpose": "Thin intent routing for one Research Task Skill plus one optional Domain Skill.",
  "not_runtime_schema": true,
  "research_task_skills": {
    "literature_review": "simflow-literature-review",
    "proposal": "simflow-proposal",
    "modeling": "simflow-modeling",
    "computation": "simflow-computation",
    "analysis_visualization": "simflow-analysis-visualization",
    "writing": "simflow-writing"
  },
  "domain_skills": {
    "vasp": "simflow-vasp",
    "cp2k": "simflow-cp2k",
    "lammps": "simflow-lammps",
    "gpumd_nep": "simflow-gpumd",
    "mlp_methodology": "simflow-mlp"
  },
  "selection_policy": {
    "max_research_task_skills": 1,
    "max_domain_skills": 1,
    "selection_basis": "current_user_intent",
    "directory_or_phase_drives_selection": false,
    "load_future_maybe_relevant_skills": false
  },
  "intent_examples": [
    {
      "intent": "analyze_existing_gpumd_md",
      "task_skill": "simflow-analysis-visualization",
      "domain_skill": "simflow-gpumd"
    },
    {
      "intent": "run_vasp",
      "task_skill": "simflow-computation",
      "domain_skill": "simflow-vasp"
    },
    {
      "intent": "design_nep_active_learning",
      "task_skill": "simflow-proposal",
      "domain_skill": "simflow-mlp"
    },
    {
      "intent": "write_existing_results",
      "task_skill": "simflow-writing",
      "domain_skill": null
    }
  ],
  "runtime_escalation_triggers": [
    "first_use_read_only_experiment_inspection",
    "inspect_recorded_project_events",
    "record_real_run_or_deliverable",
    "real_local_execution",
    "remote_execution",
    "scheduler_submit",
    "credentials_or_private_keys",
    "licensed_or_proprietary_files",
    "vasp_potcar_material",
    "destructive_operation",
    "recovery_or_restore"
  ],
  "project_memory_policy": {
    "scope": "first_simflow_use_per_project_per_user_request",
    "tool": "inspect",
    "read_only": true,
    "writes_session_state": false,
    "reuse_within_request": true,
    "silent_binding_requires_unambiguous_match": true,
    "ambiguity_blocks_only_durable_write_or_execution_binding": true,
    "fixed_reentry_summary_required": false
  },
  "ambiguous_intent_policy": {
    "return_smallest_plausible_skill_set": true,
    "list_missing_information": true,
    "ask_only_for_blockers": true,
    "do_not_default_unknown_software_to_supported_helper": true,
    "do_not_default_unknown_computation_tasks_to_known_tasks": [
      "static",
      "ENERGY",
      "NVT",
      "training"
    ]
  },
  "toolchain_contract_reference": {
    "source": "workflow/toolchains/capabilities.json",
    "purpose": "Single source of truth for helper and capability support.",
    "router_behavior": "Use software names for routing only; do not duplicate capability support."
  },
  "prohibited_actions": [
    "centralized_executor_behavior",
    "domain_parser_behavior_from_top_level_router",
    "skill_selection_from_directory_or_phase",
    "mandatory_mcp_engagement_from_skill_selection",
    "real_execution_or_submit",
    "credential_handling",
    "fabricated_literature_results_data_figures_citations_convergence_or_job_states"
  ],
  "host_adaptation_policy": {
    "skill_load_hooks_required": false,
    "supported_profiles": [
      "codex",
      "claude_code",
      "opencode",
      "generic"
    ],
    "host_specific_behavior": [
      "invocation_syntax",
      "discovery_guidance"
    ],
    "host_invariant_behavior": [
      "intent_based_selection",
      "one_task_plus_one_domain_limit",
      "runtime_separation",
      "single_read_only_memory_reentry",
      "scientific_truthfulness"
    ]
  }
}
