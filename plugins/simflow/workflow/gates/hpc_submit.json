{
  "name": "hpc_submit",
  "description": "Compatibility review label only. Real execution authorization belongs exclusively to hpc/plan plus approval bound to run_plan_hash and hpc/submit.",
  "type": "approval",
  "conditions": [
    {
      "id": "dry_run_passed",
      "evidence": "compute/dry_run_report.json",
      "path": "$.status",
      "op": "in",
      "value": ["pass", "warning"]
    },
    {
      "id": "input_files_complete",
      "evidence": "compute/input_validation.json",
      "path": "$.missing_required_files",
      "op": "length_eq",
      "value": 0
    },
    {
      "id": "resource_request_reasonable",
      "evidence": "compute/resource_estimate.json",
      "path": "$.status",
      "op": "in",
      "value": ["pass", "warning"]
    },
    {
      "id": "credentials_clean",
      "evidence": "security/credential_scan.json",
      "path": "$.findings",
      "op": "length_eq",
      "value": 0
    },
    {
      "id": "approval_present",
      "evidence": "state/gates.json",
      "path": "$.hpc_submit.latest_decision",
      "op": "eq",
      "value": "approved"
    }
  ],
  "actions_on_approve": [],
  "actions_on_reject": ["use_public_hpc_plan_and_bound_approval"],
  "auto_approve": false,
  "timeout_minutes": 60
}
