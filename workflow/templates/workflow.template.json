{
  "workflow_name": "{{ workflow_name }}",
  "recipe": "{{ recipe }}",
  "description": "{{ description }}",
  "stages": [
    {
      "name": "{{ first_stage }}",
      "required": true
    },
    {
      "name": "{{ second_stage }}",
      "required": true,
      "depends_on": ["{{ first_stage }}"]
    }
  ],
  "gates": [],
  "policies": [
    "dry_run_default",
    "recovery_checkpoint",
    "logical_event_recording",
    "approval_for_real_execution",
    "no_credential_storage"
  ],
  "entry_point": "{{ first_stage }}",
  "exit_points": ["{{ last_stage }}"],
  "metadata": {
    "author": "{{ author }}",
    "version": "0.1.0",
    "created_at": "{{ created_at }}"
  }
}
